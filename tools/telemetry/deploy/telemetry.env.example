# TEMPLATE ONLY. Copy to /etc/brooklyn-map/telemetry.env on the host, then:
#   sudo chown root:root /etc/brooklyn-map/telemetry.env
#   sudo chmod 600 /etc/brooklyn-map/telemetry.env   (systemd reads EnvironmentFile as root)
# NEVER commit the populated file. Replace every REPLACE_ME locally.
# Use only the read-only bkmap-collector identity, never the goldwein admin account.
# Do not add quotes or trailing spaces: systemd EnvironmentFile values are taken literally.
BROOKLYN_MQTT_HOST=mqtt.goldwein.net
BROOKLYN_MQTT_PORT=8884
BROOKLYN_MQTT_COLLECTOR_USER=REPLACE_ME
BROOKLYN_MQTT_COLLECTOR_PASSWORD=REPLACE_ME
